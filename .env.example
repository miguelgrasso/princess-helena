# Copiá este archivo a .env para levantar el entorno con docker compose.
# .env está ignorado por git (ver .gitignore); este ejemplo NO lleva secretos reales.

# --- Postgres (el compose crea la base con estos valores) ---
POSTGRES_USER=helena
POSTGRES_DB=helena
# Obligatoria: sin esto `docker compose up` falla con un mensaje claro.
# Es sólo para local; en el cluster va en un Secret.
# Usá sólo letras, números, punto, guión y guión bajo: el compose la mete dentro
# de DATABASE_URL, y un @ : / # ? rompe la URL (la API no conecta y igual figura
# "healthy", porque /healthz no toca la base). Si necesitás otros caracteres,
# definí DATABASE_URL entera acá abajo, ya codificada.
POSTGRES_PASSWORD=cambiame-en-local
# DATABASE_URL=postgres://usuario:p%40ss@postgres:5432/helena

# POSTGRES_USER y POSTGRES_DB sólo se aplican cuando se crea el volumen. Si los
# cambiás después, Postgres los ignora: hay que hacer `docker compose down -v`
# (borra los datos) para que vuelva a inicializarse.

# --- API (opcionales; los defaults son los seguros) ---
# Orígenes permitidos para CORS. Vacío = sin CORS, que es lo que corresponde
# cuando juego y API comparten dominio.
CORS_ORIGIN=
# Proxies de confianza para leer X-Forwarded-For. Vacío = no confiar en nadie.
# En compose no hay proxy delante, así que se deja vacío.
TRUST_PROXY=
LOG_LEVEL=info
