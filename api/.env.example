# Copiá este archivo a .env para desarrollo local.
# En Kubernetes estos valores vienen de un ConfigMap (los no sensibles)
# y de un Secret (DATABASE_URL). Nunca se quema un valor en el código.

# --- Servidor ---
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

# --- Base de datos ---
# Formato: postgres://usuario:password@host:puerto/basededatos
DATABASE_URL=postgres://helena:helena@localhost:5432/helena
DB_POOL_MAX=10

# --- Seguridad ---
# Orígenes permitidos para CORS, separados por coma. "*" sólo para desarrollo.
# En producción se sirve todo bajo el mismo dominio vía Ingress y no hace falta.
CORS_ORIGIN=*
# Máximo de puntajes que una misma IP puede enviar por minuto.
RATE_LIMIT_MAX=20
RATE_LIMIT_WINDOW=1 minute
# Proxies de confianza para tomar la IP real de X-Forwarded-For (rate limit).
# Vacío = no se confía en nadie (local / docker run).
# Detrás de un Ingress: las IPs o CIDR de sus pods, separadas por coma
# (ej. 10.244.0.0/16, la red de pods por defecto de kind).
# Se rechazan "true" (cualquier cliente inventaría su IP) y los números de
# saltos (Fastify 5 los ignora y el límite quedaría compartido entre todos).
TRUST_PROXY=
